    "readable-stream": "^4.4.2",
    "text-encoding": "^0.7.0",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "react-native",
    "verifiable-credentials",
    "wallet",
    "employment",
    "blockchain",
    "did",
    "mobile"
