        "id": "admin-role",
        "name": "ADMIN",
        "description": "Platform administrator with full access",
        "composite": false,
        "clientRole": false,
        "containerId": "provenly"
      },
      {
        "id": "issuer-role",
        "name": "ISSUER",
        "description": "Organization that can issue employment credentials",
        "composite": false,
        "clientRole": false,
        "containerId": "provenly"
      },
      {
        "id": "verifier-role",
        "name": "VERIFIER",
        "description": "Entity that can verify employment credentials",
        "composite": false,
        "clientRole": false,
        "containerId": "provenly"
      },
      {
        "id": "holder-role",
        "name": "HOLDER",
        "description": "Individual who holds employment credentials",
        "composite": false,
        "clientRole": false,
        "containerId": "provenly"
      }
    ]
  },
  "groups": [
    {
      "id": "organizations",
      "name": "Organizations",
      "path": "/Organizations",
      "attributes": {},
